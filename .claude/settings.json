{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/agent/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/agent/hooks/pre-compact.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bash scripts/agent/:*)",
      "Bash(bash scripts/agent/hooks/:*)",
      "Bash(pnpm build)",
      "Bash(pnpm dev)",
      "Bash(pnpm install)",
      "Bash(pnpm format:prettier)",
      "Bash(pnpm format:prettier:fix)",
      "Bash(pnpm format:stylelint)",
      "Bash(pnpm format:stylelint:fix)",
      "Bash(curl -s http://localhost:3000:*)",
      "Bash(curl -s -X POST http://localhost:3000:*)"
    ]
  }
}
