{
  "outputStyle": "Lean",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/agent/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/agent/hooks/pre-compact.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bash scripts/agent/:*)",
      "Bash(bash scripts/agent/hooks/:*)",
      "Bash(pnpm build)",
      "Bash(pnpm dev)",
      "Bash(pnpm install)",
      "Bash(pnpm format:prettier)",
      "Bash(pnpm format:prettier:fix)",
      "Bash(pnpm format:stylelint)",
      "Bash(pnpm format:stylelint:fix)",
      "Bash(curl -s http://localhost:3000:*)",
      "Bash(curl -s -X POST http://localhost:3000:*)"
    ],
    "deny": [
      "Read(./.env*)",
      "Edit(./.env*)",
      "Bash(cat .env*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main*)",
      "Bash(vercel deploy*)",
      "Bash(vercel --prod*)",
      "Bash(vercel env*)",
      "Bash(vercel pull*)",
      "Bash(vercel remove*)",
      "Bash(vercel rm *)",
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(yarn *)"
    ]
  },
  "extraKnownMarketplaces": {
    "megalinter": {
      "source": {
        "source": "github",
        "repo": "oxsecurity/megalinter"
      }
    },
    "egm": {
      "source": {
        "source": "github",
        "repo": "google/elephant-goldfish-model"
      }
    }
  },
  "enabledPlugins": {
    "megalinter@megalinter": true,
    "egm@egm": true
  }
}
